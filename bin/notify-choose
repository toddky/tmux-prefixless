#!/usr/bin/env bash
# USAGE: notify-choose
# DESCRIPTION: Pop a tmux menu of pending pane notifications; select to switch.

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
notify_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/tmux-notify"
[[ -d "$notify_dir" ]] || { tmux display-message "No notifications"; exit 0; }

title_dir="${XDG_CACHE_HOME:-$HOME/.cache}/title"
now="$(date +%s)"

# j/k are reserved for menu navigation, q closes the menu.
keys=(a b c d e f g h i l m n o p r s t u v w x y z)

pane_ids=()
pane_infos=()
messages=()
message_colors=()
ages=()
max_info_len=0
max_message_len=0

# ==============================================================================
# COLLECT NOTIFICATIONS
# ==============================================================================
# Newest notification first, ordered by file mtime.
mapfile -t notify_files < <(ls -t "$notify_dir"/*.txt 2>/dev/null)
for notify_file in "${notify_files[@]}"; do
	[[ -f "$notify_file" ]] || continue
	pane_id="$(basename "$notify_file" .txt)"
	pane_info="$(tmux display-message -t "%${pane_id}" -p '#{session_name} > #{window_name}(#{window_index}).#{pane_index}' 2>/dev/null)"

	# A pane with no info no longer exists; drop its stale notification.
	[[ -z "$pane_info" ]] && { rm -f "$notify_file"; continue; }

	pane_ids+=("$pane_id")
	pane_infos+=("$pane_info")

	# Prefer the cached session title over the raw notification body.
	title_file="${title_dir}/${pane_id}.txt"
	if [[ -f "$title_file" ]]; then
		read -r message < "$title_file"
		message_colors+=("colour229")
	else
		read -r message < "$notify_file"
		message_colors+=("white")
	fi

	# Cap message width so rows fit the popup; wider rows draw a scroll arrow.
	(( ${#message} > 50 )) && message="${message:0:47}..."
	messages+=("$message")
	(( ${#message} > max_message_len )) && max_message_len=${#message}

	# Age from notification file mtime. Use minutes under an hour, else hours.
	age_seconds=$(( now - $(stat -c %Y "$notify_file") ))
	age_minutes=$(( age_seconds / 60 ))
	age_hours=$(( age_seconds / 3600 ))
	if (( age_minutes < 1 )); then
		ages+=("just now")
	elif (( age_minutes == 1 )); then
		ages+=("1 minute")
	elif (( age_minutes < 60 )); then
		ages+=("${age_minutes} minutes")
	elif (( age_hours == 1 )); then
		ages+=("1 hour")
	else
		ages+=("${age_hours} hours")
	fi

	(( ${#pane_info} > max_info_len )) && max_info_len=${#pane_info}
done

if [[ ${#pane_ids[@]} -eq 0 ]]; then
	tmux display-message "No notifications"
	exit 0
fi

# ==============================================================================
# BUILD MENU
# ==============================================================================
# Floor only, so very short pane-info still leaves room for the age column.
(( max_info_len < 20 )) && max_info_len=20

display_args=(-T "Notifications" -H "bg=colour237,fg=colour45" -s "fg=colour226" -S "fg=colour196")

for index in "${!pane_ids[@]}"; do
	pane_id="${pane_ids[$index]}"
	padded_title="$(printf "%-${max_message_len}s" "${messages[$index]}")"
	padded_info="$(printf "%-${max_info_len}s" "${pane_infos[$index]}")"
	key="${keys[$index]:-}"
	quoted_notify_file="$(printf '%q' "$notify_dir/${pane_id}.txt")"
	menu_command="run-shell 'tmux switch-client -t %${pane_id} && tmux resize-pane -y 999; rm -f ${quoted_notify_file}'"

	# Title (gold/white) then pane info (cyan) then dim age; trailing cyan so
	# the selected row's access key stands out instead of inheriting dim gray.
	title_field="#[fg=${message_colors[$index]},bold]${padded_title}"
	info_field="#[fg=colour45,nobold]${padded_info}"
	age_field="#[fg=colour245][${ages[$index]}]#[fg=colour45]"
	display_args+=("${title_field} ${info_field} ${age_field}" "$key" "$menu_command")
done

# ==============================================================================
# DISPLAY
# ==============================================================================
tmux display-menu "${display_args[@]}"
