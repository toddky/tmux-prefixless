#!/usr/bin/env bash
# USAGE: chat-choose
# DESCRIPTION: Pop an fzf list of the most recent agent chat per pane; select to switch.

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
chat_dir="${XDG_DATA_HOME:-$HOME/.local/share}/agent_chats"
[[ -d "$chat_dir" ]] || { tmux display-message "No chats"; exit 0; }

title_dir="${XDG_CACHE_HOME:-$HOME/.cache}/title"
script_self="$(realpath "$0")"

# ANSI colors so fzf --ansi can render them; tmux #[...] spans do not apply here.
gold=$'\033[1;38;5;229m'
white=$'\033[1;37m'
cyan=$'\033[38;5;45m'
gray=$'\033[38;5;245m'
reset=$'\033[0m'

# ==============================================================================
# PICK MODE
# ==============================================================================
# Re-invoked inside the popup. Run fzf over the prebuilt list, switch on select.
if [[ "$1" == "--pick" ]]; then
	list_file="$2"
	fzf_args=(--ansi --delimiter=$'\t' --with-nth='2..' --reverse --prompt='chat> ' --no-sort)
	fzf_args+=(--exact)
	selection="$(fzf "${fzf_args[@]}" < "$list_file")"
	rm -f "$list_file"
	[[ -z "$selection" ]] && exit 0
	pane_id="${selection%%$'\t'*}"
	tmux switch-client -t "%${pane_id}" && tmux resize-pane -y 999
	exit 0
fi

# ==============================================================================
# COLLECT CHATS
# ==============================================================================
now="$(date +%s)"
pane_ids=()
pane_infos=()
colored_messages=()
message_lens=()
ages=()
max_info_len=0
max_message_len=0
max_age_len=0

# Resolve every live pane in one tmux call into a lookup map. A per-file
# display-message would spawn one subprocess per chat (hundreds, ~2s total).
declare -A pane_info_by_id
while read -r live_id live_info; do
	pane_info_by_id["${live_id#%}"]="$live_info"
done < <(tmux list-panes -a -F '#{pane_id} #{session_name} > #{window_name}(#{window_index}).#{pane_index}')

# Files are named YYYYMMDD_HHMMSS_<pane>.txt with many per pane. List newest
# first by mtime, then keep each pane's most recent file via awk on $NF.
mapfile -t chat_files < <(ls -t "$chat_dir"/*.txt 2>/dev/null | awk -F'[_/]' '!seen[$NF]++')
for chat_file in "${chat_files[@]}"; do
	[[ -f "$chat_file" ]] || continue
	chat_name="$(basename "$chat_file" .txt)"
	pane_id="${chat_name##*_}"
	pane_info="${pane_info_by_id[$pane_id]}"

	# A pane with no info no longer exists; skip but keep the chat log.
	[[ -z "$pane_info" ]] && continue

	# No cached title means nothing to label the row with, so skip the pane.
	title_file="${title_dir}/${pane_id}.txt"
	[[ -f "$title_file" ]] || continue
	read -r title < "$title_file"
	[[ -z "$title" ]] && continue

	pane_ids+=("$pane_id")
	pane_infos+=("$pane_info")

	read -r chat_body < "$chat_file"
	(( ${#chat_body} > 60 )) && chat_body="${chat_body:0:57}..."

	# Title (gold) and chat body (white) smooshed into one field; color tells
	# them apart. Keep the plain length so the padding pass ignores ANSI bytes.
	colored_messages+=("${gold}${title}${reset} ${white}${chat_body}${reset}")
	message_len=$(( ${#title} + 1 + ${#chat_body} ))
	message_lens+=("$message_len")
	(( message_len > max_message_len )) && max_message_len=$message_len

	# Age from chat file mtime. Use minutes under an hour, else hours.
	age_seconds=$(( now - $(stat -c %Y "$chat_file") ))
	age_minutes=$(( age_seconds / 60 ))
	age_hours=$(( age_seconds / 3600 ))
	if (( age_minutes < 1 )); then
		ages+=("just now")
	elif (( age_minutes == 1 )); then
		ages+=("1 minute")
	elif (( age_minutes < 60 )); then
		ages+=("${age_minutes} minutes")
	elif (( age_hours == 1 )); then
		ages+=("1 hour")
	else
		ages+=("${age_hours} hours")
	fi

	(( ${#pane_info} > max_info_len )) && max_info_len=${#pane_info}
	(( ${#ages[-1]} > max_age_len )) && max_age_len=${#ages[-1]}
done

if [[ ${#pane_ids[@]} -eq 0 ]]; then
	tmux display-message "No chats"
	exit 0
fi

# ==============================================================================
# BUILD LIST
# ==============================================================================
# Floor only, so very short pane-info still leaves room for the age column.
(( max_info_len < 20 )) && max_info_len=20

# Hidden pane id is field 1 (tab-separated); fzf hides it via --with-nth=2.. .
list_file="$(mktemp)"
for index in "${!pane_ids[@]}"; do
	colored_message="${colored_messages[$index]}"
	plain_len="${message_lens[$index]}"
	(( plain_len < max_message_len )) && colored_message+="$(printf "%$(( max_message_len - plain_len ))s" "")"
	padded_info="$(printf "%-${max_info_len}s" "${pane_infos[$index]}")"
	padded_age="$(printf "%-${max_age_len}s" "${ages[$index]}")"
	row="${gray}[${padded_age}]${reset} ${colored_message} ${cyan}${padded_info}${reset}"
	printf '%s\t%s\n' "${pane_ids[$index]}" "$row" >> "$list_file"
done

# ==============================================================================
# DISPLAY
# ==============================================================================
# Fixed width sized to the content so rows have no trailing blank space:
# [age] + space + message + space + pane info, plus fzf gutter and popup border.
popup_width=$(( max_age_len + 2 + 1 + max_message_len + 1 + max_info_len + 4 ))
term_width="$(tmux display-message -p '#{client_width}')"
(( popup_width > term_width )) && popup_width=$term_width

tmux display-popup -w "$popup_width" -h 80% -T " Agent Chats " -E "$script_self --pick $list_file"
