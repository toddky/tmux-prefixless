#!/usr/bin/env bash
# USAGE: popup <command>
# DESCRIPTION: Run a command in a borderless popup laid over the active pane; it closes when the command succeeds.

# ==============================================================================
# ARGUMENTS
# ==============================================================================
if (($# == 0)); then
	echo "ERROR: popup: no command given" 1>&2
	exit 1
fi
command="$*"


# ==============================================================================
# MAIN
# ==============================================================================
# display-popup expands formats in -x/-y but not -w/-h, so the size has to come from the pane here.
read -r pane_width pane_height < <(tmux display-message -p '#{pane_width} #{pane_height}')

popup_args=(-B -E -E)
popup_args+=(-x '#{popup_pane_left}' -y '#{popup_pane_top}')
popup_args+=(-w "$pane_width" -h "$pane_height")
tmux display-popup "${popup_args[@]}" "$command"
