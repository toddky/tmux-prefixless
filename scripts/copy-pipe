#!/usr/bin/env bash
# USAGE: copy-pipe < text
# DESCRIPTION: Copy stdin to a tmux buffer and the system clipboard.

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
# "3.5a" and "next-3.6" both reduce to a major and minor number.
tmux_version="$(tmux display-message -p '#{version}')"
IFS=. read -r major_version minor_version <<<"${tmux_version//[^0-9.]/}"

# load-buffer -w forwards the buffer to the clipboard itself; it arrived in 3.2 but crashes the server before 3.4.
supports_clipboard=0
if ((major_version > 3 || (major_version == 3 && minor_version >= 4))); then
	supports_clipboard=1
fi


# ==============================================================================
# TMUX CLIPBOARD
# ==============================================================================
# tmux sends the clipboard escape (OSC 52) straight to the client terminal, so this works from popups and copy mode.
# Needs set-clipboard on in tmux.conf; printing OSC 52 from a script never reached the terminal through tmux's pipes.
if ((supports_clipboard)); then
	if ! tmux load-buffer -w -; then
		echo "ERROR: copy-pipe: tmux load-buffer failed; check that tmux is running and set-clipboard is on" 1>&2
		exit 1
	fi
	exit 0
fi


# ==============================================================================
# OSC 52 FALLBACK
# ==============================================================================
# Older tmux only fills a buffer, so write OSC 52 to the client's terminal device, which reaches it even over ssh.
text_file="$(mktemp)"
trap 'rm -f "$text_file"' EXIT
cat > "$text_file"

if ! tmux load-buffer "$text_file"; then
	echo "ERROR: copy-pipe: tmux load-buffer failed; check that tmux is running" 1>&2
	exit 1
fi
client_tty="$(tmux display-message -p '#{client_tty}')"
encoded_text="$(base64 < "$text_file" | tr -d '\n')"
if ! printf '\033]52;c;%s\a' "$encoded_text" > "$client_tty"; then
	echo "ERROR: copy-pipe: cannot write to $client_tty; copied to a tmux buffer only" 1>&2
	exit 1
fi
